# Backend (.env in repo root or backend/; set the same keys in Render's dashboard)
GROQ_API_KEY=your_api_key_here
# Neon: Dashboard -> Connect -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Comma-separated frontend origins allowed to call the API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (frontend/.env.local; set in Vercel's dashboard)
# VITE_API_BASE_URL=http://localhost:8000
